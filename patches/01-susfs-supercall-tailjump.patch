+/*
+ * Tail-jump target of the kprobe fallback.
+ *
+ * reboot_pre() points regs->pc here rather than skipping to regs->regs[30].  Execution
+ * resumes in the syscall's own context (process context, so the handlers may sleep and
+ * copy_from_user), x30 is untouched, and this function's return goes straight back to
+ * invoke_syscall(), which stores it as the result.  Nothing is deferred, so answering 0
+ * means the command actually ran - the caller never sees a success the kernel did not
+ * deliver.
+ */
+static long reboot_tramp(const struct pt_regs *uregs)
+{
+	int magic1, magic2;
+	unsigned int cmd;
+	void __user *payload;
+	long ret = -EINVAL;
+
+	if (!try_module_get(THIS_MODULE))
+		return -EINVAL;
+
+	magic1 = (int)uregs->regs[0];
+	magic2 = (int)uregs->regs[1];
+	cmd = (unsigned int)uregs->regs[2];
+	payload = (void __user *)uregs->regs[3];
+
+	/* reboot_pre() matched these already; the feature bitmap can however have been
+	 * disarmed between the probe and this call. */
+	if (magic1 == KSU_INSTALL_MAGIC1 && magic2 == SUSFS_MAGIC && current_uid().val == 0 &&
+	    susfs_cmd_handled(cmd)) {
+		susfs_supercall_dispatch(cmd, payload);
+		ret = 0;
+	} else {
+		SUSFS_LOGI("susfs supercall: cmd 0x%x is not handled any more\n", cmd);
+	}
+
+	module_put(THIS_MODULE);
+
+	return ret;
+}
