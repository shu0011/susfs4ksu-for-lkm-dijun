--- a/kernel/susfs_hide_syms.c
+++ b/kernel/susfs_hide_syms.c
@@ -571,6 +571,20 @@
 	return strnlen(it->module_name, sizeof(it->module_name)) < sizeof(it->module_name);
 }
 
+/* Tail-jump target for "skip this entry".
+ *
+ * The old spelling set regs->pc = regs->regs[30] to fake the callee's return.  x30 is the
+ * caller's return address only when the callee was reached with a bl; a tail-called callee
+ * leaves x30 pointing into an outer frame, and resuming there corrupts that frame - the
+ * crash seen on the first read of /proc/kallsyms.  Jumping to a real function leaves x30
+ * alone, and this one answers 0, which is what every skip site wants (0 = the entry was
+ * emitted, nothing printed).
+ */
+static long susfs_skip_entry(void)
+{
+	return 0;
+}
+
 /* s_show(m, p): m is arg #1 (x0), read through the same accessor the m_show handler below uses
  * (on arm64 regs_get_kernel_argument(regs, n) is regs->regs[n] - the two spellings are the same
  * register, this one is just harder to get wrong if the prototype ever changes). */
@@ -606,14 +620,12 @@
 	 * module symbols carry their own spelling (e.g. __kstrtab_foo) with the module's name in module_name. */
 	if (name_should_hide(iter->name)) {
 		atomic_inc(&hide_hit_count);
-		regs->regs[0] = 0;              /* s_show returns 0 */
-		regs->pc = regs->regs[30];      /* skip the line */
+		regs->pc = (unsigned long)susfs_skip_entry;	/* skip the line */
 		return 1;
 	}
 	if (iter->module_name[0] && hide_module_name_match(iter->module_name)) {
 		atomic_inc(&n_kallsyms_mod_skipped);
-		regs->regs[0] = 0;
-		regs->pc = regs->regs[30];
+		regs->pc = (unsigned long)susfs_skip_entry;
 		return 1;
 	}
 	return 0;
@@ -661,8 +673,7 @@
 		return 0;
 
 	atomic_inc(&n_modlines_skipped);
-	regs_set_return_value(regs, 0);		/* no output for this entry */
-	regs->pc = regs->regs[30];
+	regs->pc = (unsigned long)susfs_skip_entry;	/* no output for this entry */
 	return 1;
 }
 
